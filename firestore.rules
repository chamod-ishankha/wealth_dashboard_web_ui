rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // helper: signed-in check
    function isSignedIn() {
      return request.auth != null;
    }

    // Transactions: all reads/writes must be scoped to the owner userId
    match /transactions/{transactionId} {
      // create: userId must match authenticated user and basic type checks
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.date is timestamp
        && request.resource.data.category is string
        && request.resource.data.transactionType is string
        && request.resource.data.description is string;

      // read/update/delete: only owner can operate
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        // prevent transferring ownership
        && request.resource.data.userId == resource.data.userId
        // validate types on update as well
        && request.resource.data.amount is number
        && request.resource.data.date is timestamp
        && request.resource.data.category is string
        && request.resource.data.transactionType is string
        && request.resource.data.description is string;
    }

    // Monthly budgets / salaries per period: scoped to owner
    match /monthlyBudgets/{budgetId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.periodKey is string
        && request.resource.data.monthlySalary is number;

      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // on update ensure userId unchanged
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.periodKey is string
        && request.resource.data.monthlySalary is number;
    }

    // Users collection: only the user may read/update their own profile
    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // User categories: scoped to owner
    match /userCategories/{categoryDocId} {
      // Extract userId from docId format: {userId}_categories
      function getUserIdFromDocId() {
        return categoryDocId.split('_')[0];
      }

      allow create: if isSignedIn()
        && getUserIdFromDocId() == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.categories is list;

      allow read, update, delete: if isSignedIn()
        && getUserIdFromDocId() == request.auth.uid
        && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && getUserIdFromDocId() == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.categories is list;
    }

    // Deny any other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
